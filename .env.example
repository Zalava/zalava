# Copy to .env; build/verify the app image first. Prefer immutable digests in deployments.
ZALAVA_IMAGE=zalava:local
ZALAVA_PORT=8080
ZALAVA_MEMORY=2g
ZALAVA_CPUS=2
# These files live in a host directory with mode 0700, outside Git.
ZALAVA_DB_ADMIN_PASSWORD_FILE=./.secrets/db-admin-password
ZALAVA_DB_PASSWORD_FILE=./.secrets/db-app-password
ZALAVA_BOOTSTRAP_LOGIN_FILE=./.secrets/bootstrap-login
ZALAVA_BOOTSTRAP_PASSWORD_FILE=./.secrets/bootstrap-password
# External override only; provision a non-superuser role and require TLS as appropriate.
# ZALAVA_EXTERNAL_DATABASE_URL=jdbc:postgresql://db.example:5432/zalava?sslmode=verify-full
# ZALAVA_EXTERNAL_DATABASE_USER=zalava
