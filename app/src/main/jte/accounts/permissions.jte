@import java.util.List
@import org.zalava.identity.accounts.application.UnifiedPermissions.Person
@import org.zalava.identity.accounts.application.UnifiedPermissions.ToolRow
@import org.zalava.identity.accounts.application.UnifiedPermissions.PageRow
@import org.zalava.capabilities.operation.application.port.in.ChatToolConfirmation.Choice
@import org.zalava.web.ui.navigation.NavigationModel
@import org.springframework.security.web.csrf.CsrfToken
@param List<Person> people
@param List<ToolRow> toolRows
@param List<PageRow> appRows
@param String subject
@param boolean personSelected
@param boolean memberSubject
@param boolean accountEnabled
@param String message = null
@param String error = null
@param CsrfToken csrf
@param NavigationModel navigation
<!doctype html><html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Permissions · Zalava</title><link rel="stylesheet" href="/css/vendor/bulma-1.0.4.min.css"><link rel="stylesheet" href="/zalava-tokens.css"><link rel="stylesheet" href="/zalava-ui.css"><script src="/zalava-ui.js" defer></script></head><body>
@template.ui.navigation(items = navigation.items(), activePage = "settings", csrfName = navigation.csrfParameter(), csrfValue = navigation.csrfToken(), accountName = navigation.accountName())
<main class="section"><div class="container settings-layout">@template.ui.settingsSections(current = "account-permissions")<div class="settings-content accounts-layout">
<h1 class="title is-3">Permissions</h1><p class="mb-3">Choose a role or person to manage their app access, tool access and Chat confirmations together.</p><p class="mb-4">Tool access decides whether a tool can be used. Confirmation decides whether an allowed Chat action asks first. App access includes the actions and data on that page.</p>
@if(message != null)<p class="notification is-success is-light" role="status">${message}</p>@endif
@if(error != null)<p class="notification is-danger is-light" role="alert">${error}</p>@endif
<form method="get" action="/zalava/accounts/permissions" class="mb-5"><label for="permission-subject" class="label">Manage permissions for</label><div class="select"><select id="permission-subject" name="subject"><optgroup label="Role defaults"><option value="member" selected="${subject.equals("member")}">All members</option><option value="administrator" selected="${subject.equals("administrator")}">All administrators</option></optgroup><optgroup label="People">@for(Person p : people)<option value="${p.id()}" selected="${subject.equals(p.id())}">${p.name()} · ${p.role()}${p.enabled() ? "" : " · Disabled"}</option>@endfor</optgroup></select></div> <button class="button is-link is-light" type="submit">Show permissions</button></form>
@if(!accountEnabled)<p class="notification is-warning is-light">This account is disabled and cannot use these permissions.</p>@endif
<section aria-labelledby="app-permissions"><h2 class="title is-4" id="app-permissions">Apps</h2><p class="mb-3">Access includes everything the app page allows.</p>
@if(appRows.isEmpty())<p class="notification is-light">No app pages are available. Start a module to manage its app.</p>@else
@for(PageRow row : appRows)<article class="box" data-permission-app="${row.page().moduleId()}:${row.page().pageId()}"><h3 class="title is-5">${row.page().title()}</h3><p class="mb-2">${row.page().moduleDisplayName()} · ${row.page().description()}</p>
@if(!memberSubject)<p>${!accountEnabled ? "Not allowed · Account disabled" : row.page().routes().isEmpty() ? "Not allowed · App unavailable" : "Allowed · Administrator access"}</p>@else
<p class="mb-2">Effective: ${row.allowed() ? "Allowed" : "Not allowed"} · ${row.source()}</p><form method="post" action="/zalava/accounts/permissions/app-access"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="subject" value="${subject}"><input type="hidden" name="moduleId" value="${row.page().moduleId()}"><input type="hidden" name="pageId" value="${row.page().pageId()}"><label class="label" for="app-${row.page().moduleId()}-${row.page().pageId()}">App access</label><div class="select"><select id="app-${row.page().moduleId()}-${row.page().pageId()}" name="decision">@if(personSelected)<option value="INHERIT" selected="${row.choice().equals("INHERIT")}">Inherit role default</option>@endif<option value="ALLOW" selected="${row.choice().equals("ALLOW")}" disabled="${row.page().routes().isEmpty()}">Allow</option><option value="DENY" selected="${row.choice().equals("DENY")}">Deny</option></select></div> <button class="button is-link" type="submit">Save app access</button></form>@endif</article>@endfor@endif</section>
<section aria-labelledby="tool-permissions"><h2 class="title is-4" id="tool-permissions">Tools and Chat</h2><p class="mb-3">Chat confirmation applies to direct Chat requests for the tools listed here. Other built-in tools and channels retain their own rules.</p>
@if(toolRows.isEmpty())<p class="notification is-light">No tools are available. Start a module to manage its tools.</p>@else
@for(ToolRow row : toolRows)<article class="box tool-access-row" data-permission-tool="${row.key().providerId()}:${row.key().toolName()}"><div class="tool-access-copy"><h3 class="title is-5 mb-1">${row.name()}</h3><p class="is-size-7 has-text-grey">${row.providerName()} · ${row.key().moduleId()}</p><p>${row.description()}</p><details><summary>Technical details</summary><p>Tool ID: ${row.key().toolName()}</p></details>@if(!row.available())<p class="tag is-warning is-light">Provider unavailable</p>@endif</div><div class="tool-access-actions">
@if(row.hostRead())<p class="mb-3">Tool access: Governed by document permissions. Each read still checks whether the person can access the document.</p>@elseif(!memberSubject)<p class="mb-3">Tool access: ${!accountEnabled ? "Not allowed · Account disabled" : row.available() ? "Allowed · Administrator" : "Not allowed · Provider unavailable"}</p>@else
<p class="mb-2">Tool access: ${row.accessEffective()} · ${row.accessSource()}</p><form method="post" action="/zalava/accounts/permissions/tool-access" class="mb-3"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="subject" value="${subject}"><input type="hidden" name="moduleId" value="${row.key().moduleId()}"><input type="hidden" name="providerId" value="${row.key().providerId()}"><input type="hidden" name="toolName" value="${row.key().toolName()}"><label class="label" for="access-${row.key().providerId()}-${row.key().toolName()}">Tool access</label><div class="select"><select id="access-${row.key().providerId()}-${row.key().toolName()}" name="decision">@if(personSelected)<option value="INHERIT" selected="${row.accessChoice().equals("INHERIT")}">Inherit role default</option>@endif<option value="ALLOW" selected="${row.accessChoice().equals("ALLOW")}" disabled="${!row.eligible()}">Allow</option><option value="DENY" selected="${row.accessChoice().equals("DENY")}">Deny</option></select></div> <button class="button is-link" type="submit">Save tool access</button></form>@endif
<p class="mb-2">Chat: ${row.confirmationEffective() == Choice.REQUIRE ? "Require confirmation" : row.confirmationEffective() == Choice.AUTO ? "Run without confirmation" : Boolean.FALSE.equals(row.sideEffecting()) ? "Run without confirmation by default" : "Existing approval policy"}${row.confirmationEffective() == Choice.INHERIT && row.confirmationSource().equals("Existing approval policy") ? "" : " · " + row.confirmationSource()}</p><form method="post" action="/zalava/accounts/permissions/confirmation"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="subject" value="${subject}"><input type="hidden" name="moduleId" value="${row.key().moduleId()}"><input type="hidden" name="providerId" value="${row.key().providerId()}"><input type="hidden" name="toolName" value="${row.key().toolName()}"><label class="label" for="confirm-${row.key().providerId()}-${row.key().toolName()}">Chat confirmation</label><div class="select"><select id="confirm-${row.key().providerId()}-${row.key().toolName()}" name="decision"><option value="INHERIT" selected="${row.confirmationChoice() == Choice.INHERIT}">${personSelected ? "Inherit role default" : Boolean.FALSE.equals(row.sideEffecting()) ? "Default: no confirmation" : "Existing policy"}</option><option value="REQUIRE" selected="${row.confirmationChoice() == Choice.REQUIRE}">Require confirmation</option><option value="AUTO" selected="${row.confirmationChoice() == Choice.AUTO}" disabled="${!row.available()}">Run without confirmation</option></select></div> <button class="button is-link" type="submit">Save Chat confirmation</button></form></div></article>@endfor@endif</section>
</div></div></main></body></html>
