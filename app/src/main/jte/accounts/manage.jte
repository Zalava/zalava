@param java.util.List<org.zalava.accounts.api.ManagedAccountView> accounts
@param String error
@param org.springframework.security.web.csrf.CsrfToken csrf
<!doctype html><html lang="en"><head><meta charset="utf-8"><title>SEA accounts</title></head><body><main><h1>SEA accounts</h1>@if(error != null)<p role="alert">${error}</p>@endif
<section><h2>Create account</h2><form method="post" action="/sea/accounts/create"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><label>Login <input name="loginName" required autocomplete="username"></label><label>Temporary password <input type="password" name="temporaryPassword" required minlength="12" autocomplete="new-password"></label><label>Role <select name="role"><option value="MEMBER">Member</option><option value="ADMIN">Administrator</option></select></label><button type="submit">Create account</button></form></section>
<section><h2>Managed accounts</h2><table><thead><tr><th>Login</th><th>Role</th><th>Enabled</th><th>Password change</th><th>Actions</th></tr></thead><tbody>@for(var account : accounts)<tr><td>${account.loginName()}</td><td>${account.role()}</td><td>${account.enabled()}</td><td>${account.passwordChangeRequired()}</td><td><form method="post" action="/sea/accounts/role"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="accountId" value="${account.id()}"><button type="submit" name="role" value="MEMBER">Make member</button><button type="submit" name="role" value="ADMIN">Make administrator</button></form><form method="post" action="/sea/accounts/enabled"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="accountId" value="${account.id()}"><input type="hidden" name="enabled" value="${!account.enabled()}"><button type="submit">${account.enabled() ? "Disable" : "Enable"}</button></form><form method="post" action="/sea/accounts/password"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><input type="hidden" name="accountId" value="${account.id()}"><label>Temporary password <input type="password" name="temporaryPassword" required minlength="12" autocomplete="new-password"></label><button type="submit">Reset password</button></form></td></tr>@endfor</tbody></table></section><p><a href="/sea/control">Return to SEA Control</a></p></main></body></html>
