@param String error
@param org.springframework.security.web.csrf.CsrfToken csrf
<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Change Zalava password</title></head><body><main><h1>Change password</h1>@if(error != null)<p role="alert">${error}</p>@endif<form method="post" action="/account/password"><input type="hidden" name="${csrf.getParameterName()}" value="${csrf.getToken()}"><label>Current password <input type="password" name="currentPassword" required></label><label>New password <input type="password" name="replacementPassword" required minlength="12"></label><button type="submit">Change password</button></form></main></body></html>
